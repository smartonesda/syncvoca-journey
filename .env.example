PORT=5000
SCALAR_DOCS_ENABLED=true
JWT_SECRET=fitur_ini_berjalan_karena_keajaiban_bukan_karena_logika
DATABASE_URL="file:./dev.db"
FRONTEND_URL="http://localhost:3000"

# ==============================================================================
# KONFIGURASI KECERDASAN BUATAN (AI)
# ==============================================================================
# Silakan aktifkan salah satu blok di bawah ini sesuai dengan penyedia AI
# yang ingin Anda gunakan. Jangan lupa memberikan komentar (tanda pagar #)
# pada blok yang tidak digunakan.

# ------------------------------------------------------------------------------
# BLOK 1: GOOGLE GENERATIVE AI (Aktif Secara Bawaan)
# ------------------------------------------------------------------------------
AI_PROVIDER=google
AI_MODEL_NAME=gemini-2.5-flash
GOOGLE_AI_API_KEY=your_google_api_key

# ------------------------------------------------------------------------------
# BLOK 2: OPENROUTER (Nonaktif Secara Bawaan)
# ------------------------------------------------------------------------------
# AI_PROVIDER=openrouter
# AI_MODEL_NAME=openai/gpt-oss-120b:free
# OPENROUTER_API_KEY=your_openrouter_api_key
